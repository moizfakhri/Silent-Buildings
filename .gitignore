.env
.env.*
!.env.example
# python / notebooks
.venv/
__pycache__/
*.egg-info/
.ipynb_checkpoints/
*.pyc
# os / editor
.DS_Store
.idea/
.vscode/
node_modules/

# tool caches
.pytest_cache/
.ruff_cache/
