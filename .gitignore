# data never goes in git
data/raw/
data/interim/
data/processed/
*.parquet
*.duckdb
*.csv
*.pmtiles
!data/sample/**
!reports/**/*.csv
# map: large generated data stays out of git (the tiles are covered by *.pmtiles); the small sample and districts.json can be committed
app/web/data/facts/
app/web/data/search/
